# Apache rules for the app (published as .htaccess). PHP 8 with mysqli: see README.md.
Options -Indexes
DirectoryIndex index.php

RewriteEngine on
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# v2 messages, and the 2016-2026 ones
RewriteRule ^m/([A-Za-z0-9]{6,32})$ show.php?id=$1 [L,QSA]
RewriteRule ^ivt/(.+)$ show.php?ivt=$1 [L,QSA]
# read receipts
RewriteRule ^s/([A-Za-z0-9]{6,32})$ status.php?id=$1 [L,QSA]
RewriteRule ^contact$ contact.php [L]
# Secret Santa: the form, one participant's card, and the organizer's page
RewriteRule ^secret-santa$ secret-santa.php [L]
RewriteRule ^santa/g/([A-Za-z0-9]{6,32})$ santa.php?g=$1 [L,QSA]
RewriteRule ^santa/([A-Za-z0-9]{6,32})$ santa.php?id=$1 [L,QSA]

# nothing but the pages and assets is served
RewriteRule ^(lib|cfip|partials|local|local\.sample)\.php$ - [F]
RewriteRule ^(content|docs|tests)/ - [F]
RewriteRule ^(README\.md|LICENSE|SHA256SUMS|schema\.sql|\.git|\.backups) - [F]

AddType application/manifest+json .webmanifest

# Assets are always requested with ?v=CI_VERSION, so they can be cached for a year.
<FilesMatch "\.(woff2|css|js)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
